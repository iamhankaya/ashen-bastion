[gd_resource type="Theme" load_steps=17 format=3]

; Ashen Bastion UI teması — kaynak: docs/ui/tokens.json (renk/boyut değişirse bu dosya yeniden üretilir).
; Referans viewport 1080x2400 (stretch: canvas_items, aspect: expand). Tüm boyutlar tasarım pikselidir.
; Font dosyaları geliştirici tarafından res://assets/fonts/ altına konur (Cinzel + Inter, SIL OFL); yoksa Godot varsayılanı kullanılır.

[ext_resource type="FontFile" path="res://assets/fonts/Cinzel-Bold.ttf" id="font_display"]
[ext_resource type="FontFile" path="res://assets/fonts/Inter-Regular.ttf" id="font_body"]


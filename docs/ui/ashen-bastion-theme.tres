[resource]
default_font = ExtResource("font_body")
default_font_size = 32

Button/colors/font_color = Color(0.9373, 0.9059, 0.8392, 1)
Button/colors/font_hover_color = Color(0.9373, 0.9059, 0.8392, 1)
Button/colors/font_pressed_color = Color(0.8118, 0.7686, 0.6824, 1)
Button/colors/font_disabled_color = Color(0.6392, 0.5961, 0.5137, 1)
Button/colors/font_focus_color = Color(0.9373, 0.9059, 0.8392, 1)
Button/constants/h_separation = 18
Button/font_sizes/font_size = 44
Button/fonts/font = ExtResource("font_display")
Button/styles/normal = SubResource("btn_p_n")
Button/styles/hover = SubResource("btn_p_h")
Button/styles/pressed = SubResource("btn_p_p")
Button/styles/disabled = SubResource("btn_d")
Button/styles/focus = SubResource("focus")

ButtonSecondary/base_type = &"Button"
ButtonSecondary/styles/normal = SubResource("btn_s_n")
ButtonSecondary/styles/hover = SubResource("btn_s_h")
ButtonSecondary/styles/pressed = SubResource("btn_s_p")

Label/colors/font_color = Color(0.9373, 0.9059, 0.8392, 1)
Label/colors/font_shadow_color = Color(0, 0, 0, 0.8)
Label/constants/shadow_offset_x = 0
Label/constants/shadow_offset_y = 3
Label/font_sizes/font_size = 32

LabelTitle/base_type = &"Label"
LabelTitle/fonts/font = ExtResource("font_display")
LabelTitle/font_sizes/font_size = 96

LabelTimer/base_type = &"Label"
LabelTimer/fonts/font = ExtResource("font_display")
LabelTimer/font_sizes/font_size = 72

LabelSecondary/base_type = &"Label"
LabelSecondary/colors/font_color = Color(0.8118, 0.7686, 0.6824, 1)

LabelAccent/base_type = &"Label"
LabelAccent/colors/font_color = Color(0.8235, 0.7059, 0.4941, 1)
LabelAccent/fonts/font = ExtResource("font_display")
LabelAccent/font_sizes/font_size = 34

PanelContainer/styles/panel = SubResource("panel")
PanelRaised/base_type = &"PanelContainer"
PanelRaised/styles/panel = SubResource("panel_raised")
PanelEvrim/base_type = &"PanelContainer"
PanelEvrim/styles/panel = SubResource("panel_evrim")

ProgressBar/styles/background = SubResource("bar_bg")
ProgressBar/styles/fill = SubResource("bar_xp")
